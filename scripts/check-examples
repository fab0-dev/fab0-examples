#!/usr/bin/env python3
"""Copy each example into an empty git repository, as a project would, and check it:
- every file the project copies names its source and release on its first line (`# from …`, a JSON
  `"$comment"`, or an HTML comment after a Markdown file's front matter);
- the JSON files parse;
- the merge guard blocks what it must and lets the rest through;
- `fab0-resolve validate` accepts the wiring, with the runs repository its `store` names standing in a local folder
  (git's `url.<base>.insteadOf` sends https://github.com/ there), as it would once the project set it up;
- an example that calls connected factories (`feature`) is checked with each of them beside it, a copy of the
  example it names in CONNECTED with its home repository set as the parent's `factories` says, committed: the
  parent's `validate` must check every connection.

The engine is $FAB0_RESOLVE, else a sibling fab0-core checkout's, else `fab0-resolve` on PATH.

    scripts/check-examples [example ...]
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# a parent example: per factory it calls, the example a project copies for it
CONNECTED = {"feature": {"service": "delivery", "web": "delivery"}}
FACTORY = re.compile(r"^  ([a-z][a-z0-9-]*): \{github: ([\w.-]+/[\w.-]+), path: ([^,}]+)", re.M)
GUARD_CASES = {
    "gh pr merge 3 --squash": 2,
    "cd repo && gh pr merge 3": 2,
    "gh api -X PUT repos/o/r/pulls/3/merge": 2,
    "git push origin main": 2,
    "git -C ../web push origin HEAD:main": 2,
    "git push --force-with-lease origin fab0/1/spec": 2,
    "git push origin +fab0/1/spec": 2,
    "git push -u origin fab0/1/spec": 0,
    "gh pr view 3": 0,
    "git status": 0,
}


def engine() -> str:
    if os.environ.get("FAB0_RESOLVE"):
        return os.environ["FAB0_RESOLVE"]
    sibling = ROOT.parent / "fab0-core" / "plugins" / "fab0" / "bin" / "fab0-resolve"
    if sibling.is_file():
        return str(sibling)
    found = shutil.which("fab0-resolve")
    if not found:
        sys.exit("no fab0-resolve: set FAB0_RESOLVE")
    return found


def assemble(example: Path, project: Path) -> list[Path]:
    """What the example's README says to copy; returns the copied files."""
    subprocess.run(["git", "init", "-q", "-b", "main", str(project)], check=True)
    shutil.copytree(example / ".fab0", project / ".fab0")
    claude = project / ".claude"
    for part in ("agents", "skills", "hooks"):
        if (example / part).is_dir():
            shutil.copytree(example / part, claude / part, ignore=shutil.ignore_patterns("hooks.json"))
    if (example / "claude-settings.json").is_file():
        shutil.copy(example / "claude-settings.json", claude / "settings.json")
    return sorted(p for p in project.rglob("*") if p.is_file() and ".git" not in p.relative_to(project).parts)


def header_problem(path: Path, source: str) -> str | None:
    text = path.read_text()
    if path.suffix == ".json":
        try:
            data = json.loads(text)
        except ValueError as exc:
            return f"isn't valid JSON: {exc}"
        if path.name == "settings.json":
            return None  # merged into the project's own settings, so it carries no header
        return None if data.get("$comment") == source.removeprefix("# ") else f'has no "$comment": "{source[2:]}"'
    lines = text.splitlines()
    if path.suffix == ".md":
        if lines and lines[0] == "---":
            end = lines.index("---", 1)
            lines = lines[end + 1 :]
        return None if lines and lines[0] == f"<!-- {source[2:]} -->" else f"doesn't start with <!-- {source[2:]} -->"
    if lines and lines[0].startswith("#!"):
        lines = lines[1:]
    return None if lines and lines[0] == source else f"doesn't start with '{source}'"


def check_guard(guard: Path, project: Path) -> list[str]:
    problems = []
    for command, expected in GUARD_CASES.items():
        event = json.dumps({"tool_name": "Bash", "tool_input": {"command": command}})
        run = subprocess.run(
            [sys.executable, str(guard)],
            input=event,
            capture_output=True,
            text=True,
            env={**os.environ, "CLAUDE_PROJECT_DIR": str(project)},
        )
        if run.returncode != expected:
            problems.append(f"merge guard: `{command}` exits {run.returncode}, not {expected}")
    return problems


def runs_repository(project: Path, github: Path) -> dict:
    """A bare repository where the wiring's `store.github` points, under `github`; the environment that sends
    https://github.com/ there."""
    found = re.search(r"^store:.*github:\s*([\w.-]+/[\w.-]+)", (project / ".fab0" / "fab0.yaml").read_text(), re.M)
    if found:
        bare = github / f"{found.group(1)}.git"
        subprocess.run(["git", "init", "-q", "--bare", "-b", "main", str(bare)], check=True)
    return {
        **os.environ,
        "GIT_CONFIG_COUNT": "1",
        "GIT_CONFIG_KEY_0": f"url.{github}/.insteadOf",
        "GIT_CONFIG_VALUE_0": "https://github.com/",
    }


def connect(example: Path, project: Path) -> None:
    """Each factory the parent calls, beside it: a copy of its example, home repository as the parent names it,
    committed, since `validate` reads a connected factory's wiring at its base branch."""
    factories = {m[1]: (m[2], m[3].strip()) for m in FACTORY.finditer((project / ".fab0" / "fab0.yaml").read_text())}
    for name, source in CONNECTED.get(example.name, {}).items():
        github, path = factories[name]
        child = (project / path).resolve()
        assemble(ROOT / source, child)
        wiring = child / ".fab0" / "fab0.yaml"
        text = wiring.read_text()
        wiring.write_text(text.replace("home: {path: ., github: OWNER/REPO,", f"home: {{path: ., github: {github},"))
        who = ["-c", "user.name=check", "-c", "user.email=check@example.com"]
        subprocess.run(["git", "-C", str(child), "add", "-A"], check=True)
        subprocess.run(["git", "-C", str(child), *who, "commit", "-q", "-m", "start"], check=True)


def check(example: Path, resolve: str) -> list[str]:
    version = json.loads((example / ".claude-plugin" / "plugin.json").read_text())["version"]
    source = f"# from fab0-dev/fab0-examples {example.name}--v{version}"
    problems = []
    with tempfile.TemporaryDirectory() as tmp:
        project = Path(tmp) / example.name
        for path in assemble(example, project):
            problem = header_problem(path, source)
            if problem:
                problems.append(f"{path.relative_to(project)} {problem}")
        guard = project / ".claude" / "hooks" / "merge-guard.py"
        if guard.is_file():
            problems += check_guard(guard, project)
        env = runs_repository(project, Path(tmp) / "github")
        connect(example, project)
        run = subprocess.run([resolve, "validate", "--project", str(project)], capture_output=True, text=True, env=env)
        if run.returncode:
            try:
                errors = json.loads(run.stdout).get("errors") or [json.loads(run.stdout)]
            except ValueError:
                errors = [run.stdout + run.stderr]
            problems += [f"validate: {e}" for e in errors]
        elif example.name in CONNECTED:
            found = json.loads(run.stdout).get("factories", {})
            for name in CONNECTED[example.name]:
                if not found.get(name, {}).get("checked"):
                    problems.append(f"validate: the connection to {name} isn't checked: {found.get(name, {}).get('why')}")
    return problems


def main() -> int:
    resolve = engine()
    names = sys.argv[1:] or sorted(p.name for p in ROOT.iterdir() if (p / ".fab0").is_dir())
    status = 0
    for name in names:
        problems = check(ROOT / name, resolve)
        print(("FAIL  " if problems else "PASS  ") + name)
        for p in problems:
            print(f"  {p}")
        status |= bool(problems)
    return status


if __name__ == "__main__":
    sys.exit(main())
